@using System.Data
@model DataTable

@{
    ViewData["Title"] = "РФЗО - Увоз података";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-3 text-success fw-bold">Страница РФЗО</h2>
            <p class="lead text-muted">Изаберите обрачунски период и учитајте званичну Excel табелу.</p>
            <hr />
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header text-white py-3" style="background-color: #1f6f43;">
                    <h5 class="mb-0">📄 Учитавање РФЗО Excel табеле</h5>
                </div>
                <div class="card-body p-4">
                    
                    <form action="/Home/ObradiUvozRfzo" method="post" enctype="multipart/form-data">
                        
                        <div class="row g-3 mb-4 bg-light p-3 rounded border">
                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary mb-1">Обрачунски период за који се уноси плата:</label>
                            </div>
                            <div class="col-sm-12">
                                <input type="month" name="period" class="form-control border-success" required />
                                <small class="text-muted">Изаберите месец и годину из календара</small>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Изаберите Excel фајл са рачунара (.xlsx, .xls):</label>
                            <input type="file" name="excelFajl" class="form-control border-success" accept=".xlsx, .xls" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                            🚀 Покрени увоз података
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <!-- ТАБЕЛА ИСТОРИЈЕ ИСПОД ПОЉА ЗА УБАЦИВАЊЕ -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card shadow border-0 mb-5">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0">📊 Историја учитаних РФЗО фајлова</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model == null || Model.Rows.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            <p class="mb-0">Нема евидентираних учитавања у бази података.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="ps-3">Назив увезеног фајла</th>
                                        <th>Обрачунски период</th>
                                        <th>Датум и време увоза</th>
                                        <th class="text-center pe-3">Број записа</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow red in Model.Rows)
                                    {
                                        DateTime period = Convert.ToDateTime(red["PeriodUvoza"]);
                                        DateTime datumUvoza = Convert.ToDateTime(red["DatumUvozaPodataka"]);

                                        <tr>
                                            <td class="fw-bold text-success ps-3">
                                                🟢 @red["NazivFajla"]
                                            </td>
                                            <td>
                                                @period.ToString("MM/yyyy")
                                            </td>
                                            <td class="text-muted">
                                                @datumUvoza.ToString("dd.MM.yyyy HH:mm:ss")
                                            </td>
                                            <td class="text-center pe-3">
                                                <span class="badge bg-primary rounded-pill px-3">@red["BrojRedova"]</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
