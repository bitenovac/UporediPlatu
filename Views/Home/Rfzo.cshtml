@{
    ViewData["Title"] = "РФЗО - Увоз података";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-3 text-success fw-bold">Страница РФЗО</h2>
            <p class="lead text-muted">Превуците или учитајте званичне Excel табеле Републичког фонда за здравствено осигурање.</p>
            <hr />
        </div>
    </div>

    <!-- Зона за превлачење и учитавање фајлова -->
    <div class="row justify-content-center mt-3">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white py-3" style="background-color: #1f6f43;">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        📄 Учитавање РФЗО Excel табеле
                    </h5>
                </div>
                <div class="card-body p-5">
                    
                    <!-- Drag & Drop Поље -->
                    <div id="drop-zone" class="drop-zone">
                        <div class="drop-zone-content">
                            <div class="excel-icon mb-3">📁</div> 
                            <h5 class="fw-bold">Превуците Excel фајл овде</h5>
                            <p class="text-muted small">Подржани формати: .xlsx, .xls</p>
                            <span class="d-block my-2 text-muted">или</span>
                            <button type="button" class="btn btn-success btn-sm px-4" onclick="document.getElementById('file-input').click()">
                                Изаберите са рачунара
                            </button>
                        </div>
                        <input type="file" id="file-input" accept=".xlsx, .xls" style="display: none;" />
                    </div>

                    <!-- Статусна порука -->
                    <div id="upload-status" class="alert mt-4 d-none" role="alert"></div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Стилизовање зоне -->
<style>
    .drop-zone {
        width: 100%;
        height: 250px;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 2px dashed #1f6f43;
        border-radius: 8px;
        background-color: #fcfdfe;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .drop-zone.drag-over {
        background-color: #e8f5e9;
        border-color: #2e7d32;
        transform: scale(1.01);
    }
    .excel-icon {
        font-size: 3.5rem;
        line-height: 1;
    }
</style>

@section Scripts {
    <script>
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');
        const statusDiv = document.getElementById('upload-status');

        // Спречавање отварања фајла у претраживачу
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
            document.body.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
        });

        // Ефекат превлачења преко зоне
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('drag-over'), false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('drag-over'), false);
        });

        // Ослушкивање акција (Drop или клик)
        dropZone.addEventListener('drop', e => { if (e.dataTransfer.files.length > 0) uploadFile(e.dataTransfer.files[0]); }, false);
        fileInput.addEventListener('change', e => { if (e.target.files.length > 0) uploadFile(e.target.files[0]); }, false);

        function uploadFile(file) {
            // Валидација екстензије
            const allowed = /(\.xlsx|\.xls)$/i;
            if (!allowed.exec(file.name)) {
                prikaziStatus('Дозвољени су искључиво Excel фајлови (.xlsx, .xls)!', 'danger');
                return;
            }

            const formData = new FormData();
            // Кључ 'excelFajl' мора бити идентичан имену параметра у C# методи
            formData.append('excelFajl', file);
            
            // Пошто акција очекује и 'period', прослеђујемо тренутни датум као пример
            formData.append('period', new Date().toISOString());

            prikaziStatus('Слање и обрада фајла у току...', 'info');

            // Позивање тачне акције унутар HomeController-а
            fetch('/Home/ObradiUvozRfzo', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    prikaziStatus(data.message, 'success');
                } else {
                    prikaziStatus(data.message, 'danger');
                }
            })
            .catch(err => {
                console.error(err);
                prikaziStatus('Дошко је до грешке на мрежи или серверу.', 'danger');
            });
        }

        function prikaziStatus(poruka, tip) {
            statusDiv.textContent = poruka;
            statusDiv.className = `alert mt-3 d-block alert-${tip}`;
        }
    </script>
}
