@using System.Reflection
@model IEnumerable<UporediPlate.Models.RfzoUvoz>

@{
    ViewData["Title"] = "РФЗО - Детаљан преглед увоза";
    
    // Uzimamo sva svojstva (kolone) iz klase RfzoUvoz dinamički pomoću Reflection-a
    var svojstva = typeof(UporediPlate.Models.RfzoUvoz).GetProperties(BindingFlags.Public | BindingFlags.Instance);
}

<div class="container-fluid mt-4 px-4">
    <!-- Заглавље и Акције -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-success fw-bold mb-1">
                👁️ Детаљан преглед РФЗО увоза
            </h2>
            <p class="lead text-muted small mb-0">Приказ свих увезених редова и поља из селектованог документа</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Home/Rfzo" class="btn btn-outline-secondary px-3 fw-bold">
                ⬅️ Назад на увоз
            </a>
            <button class="btn btn-primary px-3 fw-bold" onclick="izveziUExcel()">
                🟢 Извоз у Excel
            </button>
            <button class="btn btn-success px-3 fw-bold" onclick="window.print()">
                🖨️ Штампај
            </button>
        </div>
    </div>

    <!-- Главна табела са свим динамичким подацима -->
    <div class="card shadow-lg border-0 mb-5">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 d-flex justify-content-between align-items-center">
                <span>📋 Комплетан садржај из базе података</span>
                <span class="badge bg-success rounded-pill px-3">Укупно записа: @(Model?.Count() ?? 0)</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <p class="mb-0 fs-5">Нема пронађених података за овај увоз.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="tabela-rfzo" class="table table-hover table-striped mb-0 align-middle small">
                        <thead class="table-secondary text-uppercase fs-7">
                            <tr>
                                <th class="ps-3" style="width: 60px;">#</th>
                                @* Dinamički generišemo nazive kolona uz promenu za PeriodUvoza *@
                                @foreach (var prop in svojstva)
                                {
                                    if (prop.Name == "PeriodUvoza")
                                    {
                                        <th>PeriodNaKojiSeSpisakOdnosi</th>
                                    }
                                    else
                                    {
                                        <th>@prop.Name</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int brojac = 1; }
                            @foreach (var stavka in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted ps-3">@brojac</td>
                                    @foreach (var prop in svojstva)
                                    {
                                        var vrednost = prop.GetValue(stavka);
                                        
                                        if (vrednost == null)
                                        {
                                            <td><em class="text-muted">/</em></td>
                                        }
                                        @* 1. Rešenje za JMBG (Forsiranje teksta u Excelu i 13 karaktera sa vodećim nulama) *@
                                        else if (prop.Name.ToUpper() == "JMBG")
                                        {
                                            string jmbgTekst = vrednost.ToString().Trim().PadLeft(13, '0');
                                            <td style="vnd.ms-excel.numberformat:@@" class="text-start">@jmbgTekst</td>
                                        }
                                        @* 2. Rešenje za PeriodUvoza (Forsiranje tekstualnog formata u Excelu da spreči 92.026) *@
                                        else if (prop.Name == "PeriodUvoza" && vrednost is DateTime datumPerioda)
                                        {
                                            string periodFormatiran = datumPerioda.ToString("MM/yyyy");
                                            <td style="vnd.ms-excel.numberformat:@@" class="fw-bold text-primary">@periodFormatiran</td>
                                        }
                                        else if (vrednost is decimal || vrednost is double || vrednost is float)
                                        {
                                            <td class="text-end fw-bold">@string.Format("{0:N2}", vrednost)</td>
                                        }
                                        else if (vrednost is DateTime vreme)
                                        {
                                            <td>@vreme.ToString("dd.MM.yyyy")</td>
                                        }
                                        else
                                        {
                                            <td>@vrednost.ToString()</td>
                                        }
                                    }
                                </tr>
                                brojac++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 700;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }
    .table td {
        white-space: nowrap;
    }
    .table-responsive {
        max-height: 73vh;
        overflow-y: auto;
        overflow-x: auto;
    }
    @@media print {
        .btn, border-bottom { display: none !important; }
        .card { shadow: none !important; border: 1px solid #ccc !important; }
        .table-responsive { max-height: none !important; overflow-y: visible !important; overflow-x: visible !important; }
    }
</style>

@section Scripts {
    <script>
        function izveziUExcel() {
            const tabela = document.getElementById("tabela-rfzo");
            if (!tabela) return;

            let html = tabela.outerHTML;
            
            // Dodat Microsoft Excel stilski kod unutar html-a za pravilno procesiranje CSS-a u Excelu
            const style = `<style> td { white-space:nowrap; } </style>`;
            const meta = '<meta http-equiv="content-type" content="application/vnd.ms-excel; charset=UTF-8">';
            const template = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://w3.org">${meta}<head>${style}</head><body>${html}</body></html>`;
            
            const blob = new Blob([template], { type: "application/vnd.ms-excel" });
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement("a");
            a.href = url;
            
            const datum = new Date().toISOString().slice(0,10);
            a.download = `Pregled_Uvoza_RFZO_${datum}.xls`;
            
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
}
