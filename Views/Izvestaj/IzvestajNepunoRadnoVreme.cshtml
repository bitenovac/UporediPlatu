@model List<UporediPlate.Models.IzvestajNepunoRadnoVremeViewModel>
@{
    ViewData["Title"] = "Контрола запослених са непуним радним временом (РФЗО vs ЗУ)";
    var sortiraniModel = Model?
        .OrderBy(x => x.SifraZuNormalizovana)
        .ThenBy(x => x.ProcenatRadnogVremenaRfzo)
        .ThenBy(x => x.Prezime)
        .ThenBy(x => x.Ime)
        .ToList();

    var prvaStavka = sortiraniModel?.FirstOrDefault();
    int brojZaPrvuUstanovu = prvaStavka != null
        ? sortiraniModel!.Count(x => x.SifraZuNormalizovana == prvaStavka.SifraZuNormalizovana)
        : 0;
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="fw-bold h3 mb-1" style="color: #003b73;">
                Контрола запослених са непуним радним временом (РФЗО vs ЗУ)
            </h2>
            <p class="text-muted small mb-0">
                Приказ запослених који у РФЗО евиденцији имају проценат радног времена мањи од 100%, уз обрачун максимално дозвољених сати на основу фонда установе.
            </p>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 ms-auto no-print">
            <a asp-controller="Izvestaj" asp-action="Index" class="btn btn-nazad-zuto btn-sm px-3 shadow-sm">
                ← Назад на избор фајлова
            </a>

            <form asp-controller="Izvestaj" asp-action="IzvozUExcelNepunoRadnoVreme" method="post" class="m-0">
                <input type="hidden" name="izabraniKljuceviStr" value="@ViewBag.IzabraniKljucevi" />
                <button type="submit" class="btn btn-success btn-sm px-3 fw-semibold shadow-sm" @(sortiraniModel == null || sortiraniModel.Count == 0 ? "disabled" : "")>
                    Извоз у Excel
                </button>
            </form>

            <form asp-controller="Izvestaj" asp-action="IzvozUPdfNepunoRadnoVreme" method="post" class="m-0">
                <input type="hidden" name="izabraniKljuceviStr" value="@ViewBag.IzabraniKljucevi" />
                <button type="submit" class="btn btn-danger btn-sm px-3 fw-semibold shadow-sm" @(sortiraniModel == null || sortiraniModel.Count == 0 ? "disabled" : "")>
                    Извоз у PDF
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        @if (prvaStavka != null)
        {
            <div class="zu-naslovna-linija py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                    Шифра ЗУ: @prvaStavka.SifraZuOriginal (@prvaStavka.SifraZuNormalizovana) &nbsp;|&nbsp; Назив ЗУ: @prvaStavka.NazivZu
                </span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark">Број радника: @brojZaPrvuUstanovu</span>
                    @if (sortiraniModel!.Count > brojZaPrvuUstanovu)
                    {
                        <span class="badge bg-dark text-white">Укупно радника: @sortiraniModel.Count</span>
                    }
                </div>
            </div>
        }

        <div class="status-zuta-linija py-2 px-3">
            Напомена: Црвеним фонтом су истакнути запослени код којих су сати редовног рада већи од максимално дозвољеног фонда.
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.82rem;">
                <thead class="rfzo-tabela-zaglavlje">
                    <tr>
                        <th class="text-center">Период</th>
                        <th class="text-center">ЈМБГ</th>
                        <th>Име</th>
                        <th>Презиме</th>
                        <th>Радно место</th>
                        <th class="text-end">% РВ<br />(РФЗО)</th>
                        <th class="text-end">Макс. сати<br />(РФЗО)</th>
                        <th class="text-end">Редован<br />рад (ЗУ)</th>
                        <th class="text-end">Прековремено<br />(ЗУ)</th>
                        <th class="text-end">Дежурство<br />(ЗУ)</th>
                        <th class="text-end">Укупно<br />нето (ЗУ)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sortiraniModel != null && sortiraniModel.Count > 0)
                    {
                        string trenutnaSifraZu = prvaStavka!.SifraZuNormalizovana;

                        foreach (var item in sortiraniModel)
                        {
                            if (item.SifraZuNormalizovana != trenutnaSifraZu)
                            {
                                trenutnaSifraZu = item.SifraZuNormalizovana;
                                int brojZaUstanovu = sortiraniModel.Count(x => x.SifraZuNormalizovana == trenutnaSifraZu);

                                <tr class="zu-naslovna-linija">
                                    <td colspan="11" class="py-2 px-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>
                                                Шифра ЗУ: @item.SifraZuOriginal (@item.SifraZuNormalizovana) &nbsp;|&nbsp; Назив ЗУ: @item.NazivZu
                                            </span>
                                            <span class="badge bg-light text-dark">Број радника: @brojZaUstanovu</span>
                                        </div>
                                    </td>
                                </tr>
                            }

                            bool prekoraceno = item.RedovanRadZu > item.MaksimalnoDozvoljeniSati;
                            string stilReda = prekoraceno
                                ? "color: #dc3545 !important; font-weight: 700;"
                                : "color: #212529 !important;";

                            <tr>
                                <td class="text-center" style="@stilReda">@item.PeriodUvoza.ToString("MM.yyyy")</td>
                                <td class="text-center font-monospace" style="@stilReda">@item.Jmbg</td>
                                <td style="@stilReda">@item.Ime</td>
                                <td class="fw-semibold" style="@stilReda">@item.Prezime</td>
                                <td style="@stilReda">
                                    <div class="kolona-radno-mesto" title="@item.RadnoMesto" style="@stilReda">@item.RadnoMesto</div>
                                </td>
                                <td class="text-end fw-bold" style="@stilReda">@item.ProcenatRadnogVremenaRfzo.ToString("N2")%</td>
                                <td class="text-end fw-semibold" style="@stilReda">@item.MaksimalnoDozvoljeniSati.ToString("N2")</td>
                                <td class="text-end" style="@stilReda">@item.RedovanRadZu.ToString("N2")</td>
                                <td class="text-end" style="@stilReda">@item.PrekovremeniSatiZu.ToString("N2")</td>
                                <td class="text-end" style="@stilReda">@item.DezurstvoSatiZu.ToString("N2")</td>
                                <td class="text-end fw-bold" style="@stilReda">@item.UkupanNetoZu.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-success fw-semibold py-4">
                                ✅ У изабраним фајловима нема запослених са процентом радног времена мањим од 100%!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
