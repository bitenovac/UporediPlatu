@model List<UporediPlate.Models.IzvestajNepronadjeniUZuViewModel>
@{
    ViewData["Title"] = "Радници на списку РФЗО-а који нису на списку ЗУ";
    var sortiraniModel = Model?
        .OrderBy(x => x.SifraZuNormalizovana)
        .ThenBy(x => x.Prezime)
        .ThenBy(x => x.Ime)
        .ToList();
}

<style>
    .rfzo-tabela-zaglavlje th {
        background-color: #003b73 !important;
        color: #ffffff !important;
        border-bottom: 2px solid #00264d !important;
        font-weight: 600;
    }

    .zu-naslovna-linija td {
        background-color: #198754 !important;
        color: #ffffff !important;
        border-top: 2px solid #146c43 !important;
        border-bottom: 2px solid #146c43 !important;
        font-weight: 700;
        font-size: 0.86rem;
        letter-spacing: 0.2px;
    }

    .btn-nazad-zuto {
        background-color: #ffc107;
        border: 2px solid #e0a800;
        color: #212529;
        font-weight: 600;
    }

    .btn-nazad-zuto:hover {
        background-color: #ffca2c;
        border-color: #d39e00;
        color: #000000;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="fw-bold h3 mb-1" style="color: #003b73;">Радници на списку РФЗО-а који нису на списку ЗУ</h2>
            <p class="text-muted small mb-0">Приказ запослених из РФЗО евиденције (за изабране ЗУ установе и периоде) чији се ЈМБГ не налази у достављеним ЗУ фајловима.</p>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 ms-auto no-print">
            <a asp-controller="Izvestaj" asp-action="Index" class="btn btn-nazad-zuto btn-sm px-3 shadow-sm">
                ← Назад на избор фајлова
            </a>

            <form asp-controller="Izvestaj" asp-action="IzvozUExcelNepronadjeniUZu" method="post" class="m-0">
                <input type="hidden" name="izabraniKljuceviStr" value="@ViewBag.IzabraniKljucevi" />
                <button type="submit" class="btn btn-success btn-sm px-3 fw-semibold shadow-sm" @(sortiraniModel == null || sortiraniModel.Count == 0 ? "disabled" : "")>
                    Извоз у Excel
                </button>
            </form>

            <form asp-controller="Izvestaj" asp-action="IzvozUPdfNepronadjeniUZu" method="post" class="m-0">
                <input type="hidden" name="izabraniKljuceviStr" value="@ViewBag.IzabraniKljucevi" />
                <button type="submit" class="btn btn-danger btn-sm px-3 fw-semibold shadow-sm" @(sortiraniModel == null || sortiraniModel.Count == 0 ? "disabled" : "")>
                    Извоз у PDF
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header text-white py-2 px-3 d-flex justify-content-between align-items-center"
             style="background-color: #0054a6; font-size: 0.9rem;">
            <span>Пронађена неслагања (РФЗО без поклапања у ЗУ)</span>
            <span class="badge bg-light text-dark">Укупно радника: @(sortiraniModel?.Count ?? 0)</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.82rem;">
                <thead class="rfzo-tabela-zaglavlje">
                    <tr>
                        <th>Период</th>
                        <th>ЈМБГ</th>
                        <th>Презиме и име</th>
                        <th>Радно место / Занимање</th>
                        <th>Коеф. 1</th>
                        <th>% РВ</th>
                        <th>Престанак РО</th>
                        <th>Статус провере</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sortiraniModel != null && sortiraniModel.Count > 0)
                    {
                        string trenutnaSifraZu = string.Empty;

                        foreach (var item in sortiraniModel)
                        {
                            if (item.SifraZuNormalizovana != trenutnaSifraZu)
                            {
                                trenutnaSifraZu = item.SifraZuNormalizovana;
                                int brojZaUstanovu = sortiraniModel.Count(x => x.SifraZuNormalizovana == trenutnaSifraZu);

                                <tr class="zu-naslovna-linija">
                                    <td colspan="8" class="py-2 px-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>
                                                Шифра ЗУ: @item.SifraZuNormalizovana &nbsp;|&nbsp; Назив ЗУ: @item.NazivZu
                                            </span>
                                            <span class="badge bg-light text-dark">Број радника: @brojZaUstanovu</span>
                                        </div>
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td>@item.PeriodUvoza.ToString("MM.yyyy")</td>
                                <td class="font-monospace">@item.Jmbg</td>
                                <td class="fw-semibold">@item.Prezime @item.Ime</td>
                                <td>@(string.IsNullOrWhiteSpace(item.NazivRM) ? item.NazivZanimanja : item.NazivRM)</td>
                                <td>@(item.Koef1?.ToString("N4") ?? "-")</td>
                                <td>@(item.ProcRVr?.ToString("N2") ?? "-")</td>
                                <td>@(item.DatumPrestankaRO?.ToString("dd.MM.yyyy") ?? "-")</td>
                                <td>
                                    <span class="badge bg-warning text-dark">@item.RazlogNeslaganja</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-success fw-semibold py-4">
                                ✅ Сви радници из РФЗО евиденције за изабране установе су пронађени у ЗУ фајловима!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
