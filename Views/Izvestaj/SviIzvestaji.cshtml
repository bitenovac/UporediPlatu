@model UporediPlate.Models.SviIzvestajiViewModel
@{
    ViewData["Title"] = "Обједињени приказ извештаја";
    bool imaPrvi = Model.IzabraniIzvestaji.Contains("NepronadjeniURfzo");
    bool imaDrugi = Model.IzabraniIzvestaji.Contains("NepronadjeniUZu");
    bool imaTreci = Model.IzabraniIzvestaji.Contains("NeslaganjeKoeficijenata");
    bool imaCetvrti = Model.IzabraniIzvestaji.Contains("PrekovremeniSati");

    int brojPrvi = Model.NepronadjeniURfzo?.Count ?? 0;
    int brojDrugi = Model.NepronadjeniUZu?.Count ?? 0;
    int brojTreci = Model.NeslaganjeKoeficijenata?.Count ?? 0;
    int brojCetvrti = Model.PrekovremeniSati?.Count ?? 0;

    string prviAktivan = imaPrvi ? "tab1" : (imaDrugi ? "tab2" : (imaTreci ? "tab3" : "tab4"));
}

<style>
    #izvestajiTab .nav-link.tab-sa-rezultatima {
        background-color: #e6f2fa;
        color: #003b73;
        border-color: #b8daff #b8daff #dee2e6;
        margin-right: 4px;
        transition: all 0.15s ease-in-out;
    }

    #izvestajiTab .nav-link.tab-sa-rezultatima:hover {
        background-color: #d0e7f7;
        color: #00264d;
    }

    #izvestajiTab .nav-link.tab-sa-rezultatima.active {
        background-color: #003b73 !important;
        color: #ffffff !important;
        border-color: #003b73 #003b73 #003b73 !important;
    }

    #izvestajiTab .nav-link.tab-bez-rezultata {
        background-color: #f8f9fa;
        color: #6c757d;
        margin-right: 4px;
    }

    #izvestajiTab .nav-link.tab-bez-rezultata.active {
        background-color: #ffffff !important;
        color: #495057 !important;
        border-color: #dee2e6 #dee2e6 #ffffff !important;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="fw-bold h3 mb-1" style="color: #003b73;">Резултати провере (Више извештаја)</h2>
            <p class="text-muted small mb-0">Изаберите картицу испод да бисте прегледали појединачне извештаје.</p>
        </div>
        <a asp-controller="Izvestaj" asp-action="Index" class="btn btn-warning btn-sm px-3 fw-semibold shadow-sm">
            ← Назад на избор фајлова
        </a>
    </div>

    <ul class="nav nav-tabs mb-3 fw-semibold" id="izvestajiTab" role="tablist">
        @if (imaPrvi)
        {
            string klasaPrvi = brojPrvi > 0 ? "tab-sa-rezultatima" : "tab-bez-rezultata";
            <li class="nav-item" role="presentation">
                <button class="nav-link @(prviAktivan == "tab1" ? "active" : "") @klasaPrvi d-flex align-items-center text-start lh-sm py-2" id="tab1-btn" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">
                    <span>1. На списку ЗУ,<br />а нису у РФЗО</span>
                    <span class="badge @(brojPrvi > 0 ? "bg-primary" : "bg-secondary") ms-2">@brojPrvi</span>
                </button>
            </li>
        }
        @if (imaDrugi)
        {
            string klasaDrugi = brojDrugi > 0 ? "tab-sa-rezultatima" : "tab-bez-rezultata";
            <li class="nav-item" role="presentation">
                <button class="nav-link @(prviAktivan == "tab2" ? "active" : "") @klasaDrugi d-flex align-items-center text-start lh-sm py-2" id="tab2-btn" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">
                    <span>2. На списку РФЗО,<br />а нису у ЗУ</span>
                    <span class="badge @(brojDrugi > 0 ? "bg-primary" : "bg-secondary") ms-2">@brojDrugi</span>
                </button>
            </li>
        }
        @if (imaTreci)
        {
            string klasaTreci = brojTreci > 0 ? "tab-sa-rezultatima" : "tab-bez-rezultata";
            <li class="nav-item" role="presentation">
                <button class="nav-link @(prviAktivan == "tab3" ? "active" : "") @klasaTreci d-flex align-items-center text-start lh-sm py-2" id="tab3-btn" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">
                    <span>3. Неслагање у<br />коефицијентима</span>
                    <span class="badge @(brojTreci > 0 ? "bg-primary" : "bg-secondary") ms-2">@brojTreci</span>
                </button>
            </li>
        }
        @if (imaCetvrti)
        {
            string klasaCetvrti = brojCetvrti > 0 ? "tab-sa-rezultatima" : "tab-bez-rezultata";
            <li class="nav-item" role="presentation">
                <button class="nav-link @(prviAktivan == "tab4" ? "active" : "") @klasaCetvrti d-flex align-items-center text-start lh-sm py-2" id="tab4-btn" data-bs-toggle="tab" data-bs-target="#tab4" type="button" role="tab">
                    <span>4. Прековремени<br />и додатни сати</span>
                    <span class="badge @(brojCetvrti > 0 ? "bg-primary" : "bg-secondary") ms-2">@brojCetvrti</span>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content" id="izvestajiTabContent">
        @if (imaPrvi)
        {
            ViewBag.IzabraniKljucevi = Model.IzabraniKljuceviStr;
            <div class="tab-pane fade @(prviAktivan == "tab1" ? "show active" : "")" id="tab1" role="tabpanel">
                <partial name="IzvestajNepronadjeni" model="Model.NepronadjeniURfzo" />
            </div>
        }
        @if (imaDrugi)
        {
            ViewBag.IzabraniKljucevi = Model.IzabraniKljuceviStr;
            <div class="tab-pane fade @(prviAktivan == "tab2" ? "show active" : "")" id="tab2" role="tabpanel">
                <partial name="IzvestajNepronadjeniUZu" model="Model.NepronadjeniUZu" />
            </div>
        }
        @if (imaTreci)
        {
            ViewBag.IzabraniKljucevi = Model.IzabraniKljuceviStr;
            <div class="tab-pane fade @(prviAktivan == "tab3" ? "show active" : "")" id="tab3" role="tabpanel">
                <partial name="IzvestajNeslaganjeKoeficijenata" model="Model.NeslaganjeKoeficijenata" />
            </div>
        }
        @if (imaCetvrti)
        {
            ViewBag.IzabraniKljucevi = Model.IzabraniKljuceviStr;
            <div class="tab-pane fade @(prviAktivan == "tab4" ? "show active" : "")" id="tab4" role="tabpanel">
                <partial name="IzvestajPrekovremeniSati" model="Model.PrekovremeniSati" />
            </div>
        }
    </div>
</div>
