@model List<UporediPlate.Models.ZuIstorijaViewModel>
@{
    ViewData["Title"] = "Креирање извештаја - Упореди Плату";
}

<div class="container mt-4">
    <h2 class="rfzo-page-title text-primary fw-bold h2 mb-1">Покретање провере и Креирање извештаја</h2>
    <p class="text-muted small">
        Изаберите један или више извештаја, а затим означите ЗУ фајлове за које желите да покренете проверу.
    </p>
</div>

<div class="container mt-3 mb-5">
    @if (TempData["GreskaPoruka"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small" role="alert">
            @TempData["GreskaPoruka"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Izvestaj" asp-action="GenerisiIzvestaj" method="post">

        <!-- 1. КАРТИЦА: ИЗБОР ВРСТЕ ИЗВЕШТАЈА -->
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden mb-4">
            <div class="card-header text-white py-2 px-3 d-flex justify-content-between align-items-center"
                 style="background-color: #003b73; font-size: 0.9rem;">
                <div>
                    <span class="me-2">📋</span> 1. Избор извештаја за генерисање
                </div>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="selectAllReports" style="cursor: pointer;">
                    <label class="form-check-label text-white small fw-semibold" for="selectAllReports"
                           style="cursor: pointer;">
                        Изабери све извештаје
                    </label>
                </div>
            </div>

            <div class="card-body bg-white py-3 px-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded-2 p-3 h-100 report-card" style="cursor: pointer; transition: 0.15s;">
                            <div class="form-check">
                                <input class="form-check-input report-checkbox" type="checkbox" name="izabraniIzvestaji"
                                       value="NepronadjeniURfzo" id="rep1" style="cursor: pointer;">
                                <label class="form-check-label fw-bold text-dark" for="rep1" style="cursor: pointer;">
                                    1. Радници који се налазе на списку ЗУ а који нису на списку РФЗО-а
                                </label>
                                <p class="text-muted small mb-0 mt-1">
                                    Приказује запослене из изабраних ЗУ фајлова чији се ЈМБГ и Шифра ЗУ не налазе у РФЗО
                                    бази за дати период.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-2 p-3 h-100 report-card" style="cursor: pointer; transition: 0.15s;">
                            <div class="form-check">
                                <input class="form-check-input report-checkbox" type="checkbox" name="izabraniIzvestaji"
                                       value="NepronadjeniUZu" id="rep2" style="cursor: pointer;">
                                <label class="form-check-label fw-bold text-dark" for="rep2" style="cursor: pointer;">
                                    2. Радници у РФЗО који нису у ЗУ
                                </label>
                                <p class="text-muted small mb-0 mt-1">
                                    Приказује запослене из РФЗО евиденције (за изабране установе и периоде) који нису
                                    достављени у ЗУ фајловима.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-2 p-3 h-100 report-card" style="cursor: pointer; transition: 0.15s;">
                            <div class="form-check">
                                <input class="form-check-input report-checkbox" type="checkbox" name="izabraniIzvestaji"
                                       value="NeslaganjeKoeficijenata" id="rep3" style="cursor: pointer;">
                                <label class="form-check-label fw-bold text-dark" for="rep3" style="cursor: pointer;">
                                    3. Неслагање у основним и укупним коефицијентима
                                </label>
                                <p class="text-muted small mb-0 mt-1">
                                    Пореди основни коефицијент и збир коефицијената из РФЗО базе са подацима достављеним у ЗУ фајловима.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-2 p-3 h-100 report-card" style="cursor: pointer; transition: 0.15s;">
                            <div class="form-check">
                                <input class="form-check-input report-checkbox" type="checkbox" name="izabraniIzvestaji"
                                       value="PrekovremeniSati" id="rep4" style="cursor: pointer;">
                                <label class="form-check-label fw-bold text-dark" for="rep4" style="cursor: pointer;">
                                    4. Прековремени сати, дежурство, рад по позиву и приправност (ЗУ)
                                </label>
                                <p class="text-muted small mb-0 mt-1">
                                    Приказује запослене из ЗУ фајлова са додатним сатима већим од нуле, сортирано опадајуће.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. КАРТИЦА: ИЗБОР УЧИТАНИХ ЗУ ФАЈЛОВА -->
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header text-white py-2 px-3 d-flex justify-content-between align-items-center"
                 style="background-color: #455a64; font-size: 0.9rem;">
                <div>
                    <span class="me-2">📊</span> 2. Избор учитаних ЗУ фајлова (сортирано по периоду и називу)
                </div>
                <span class="badge bg-light text-dark">Укупно фајлова: @(Model?.Count ?? 0)</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-dark" style="background-color: #263238;">
                        <tr>
                            <th style="width: 50px;" class="text-center ps-3">
                                <input type="checkbox" class="form-check-input" id="selectAll" title="Изабери све"
                                       style="cursor: pointer;" />
                            </th>
                            <th>Назив увезеног фајла</th>
                            <th>Обрачунски период</th>
                            <th>Датум и време увоза</th>
                            <th>Број записа</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center ps-3">
                                        <input type="checkbox" class="form-check-input file-checkbox" name="izabraniKljucevi"
                                               value="@item.VremeKljuc" style="cursor: pointer;" />
                                    </td>
                                    <td class="text-secondary">
                                        <span class="text-success me-1">●</span> @item.NazivFajla
                                    </td>
                                    <td>@item.PeriodUvoza.ToString("MM.yyyy")</td>
                                    <td>@item.DatumUvozaPodataka.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-primary px-2 py-1">@item.BrojRedova</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Нема евидентираних увоза за Здравствене Установе.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    Изабрано извештаја: <strong id="selectedReportsCount" class="text-primary">0</strong>
                    &nbsp;|&nbsp;
                    Изабрано фајлова: <strong id="selectedCount" class="text-dark">0</strong>
                </div>
                <button type="submit" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2"
                        id="btnKreiraj" disabled>
                    <span>📈</span> Креирај извештај
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/izvestaj-index.js" asp-append-version="true"></script>
}
