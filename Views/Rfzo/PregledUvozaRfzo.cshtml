@using System.Reflection
@model IEnumerable<RfzoUvoz>

@{
    ViewData["Title"] = "РФЗО - Детаљан преглед увоза";
    var svojstva = typeof(RfzoUvoz).GetProperties(BindingFlags.Public | BindingFlags.Instance);
}

<div class="container-fluid mt-4 px-4">
    <!-- Заглавље и Акције -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h2 class="text-success fw-bold h3 mb-1">
                👁️ Детаљан преглед РФЗО увоза
            </h2>
            <p class="text-muted small mb-0">Приказ свих увезених редова и поља из селектованог документа</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Rfzo" asp-action="Index"
               class="btn btn-warning text-dark d-flex align-items-center gap-2 fw-semibold shadow-sm">
                <span>⬅️</span> Повратак на РФЗО страницу
            </a>
            <button class="btn btn-success d-flex align-items-center gap-2 fw-semibold shadow-sm"
                    onclick="izveziUExcel()">
                <span>📥</span> Извоз у Excel
            </button>
        </div>
    </div>

    <!-- Главна табела са свим динамичким подацима -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden mb-4">
        <div class="card-header bg-dark text-white py-2 px-3">
            <h6 class="mb-0 d-flex justify-content-between align-items-center">
                <span>📋 Комплетан садржај из базе података</span>
                <span class="badge bg-success rounded-pill px-3">Укупно записа: @(Model?.Count() ?? 0)</span>
            </h6>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <p class="mb-0 fs-5">Нема пронађених података за овај увоз.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="tabela-rfzo" class="table table-sm table-hover table-striped mb-0 align-middle small"
                           style="font-size: 0.8rem;">
                        <thead class="table-dark sticky-top align-middle"
                               style="background-color: #263238; z-index: 1;">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            @foreach (var prop in svojstva)
                            {
                                if (prop.Name == "PeriodUvoza")
                                {
                                    <th>PeriodNaKojiSeSpisakOdnosi</th>
                                }
                                else
                                {
                                    <th>@prop.Name</th>
                                }
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            var brojac = 1;
                        }
                        @foreach (var stavka in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted ps-3">@brojac</td>
                                @foreach (var prop in svojstva)
                                {
                                    var vrednost = prop.GetValue(stavka);

                                    if (vrednost == null)
                                    {
                                        <td><em class="text-muted">/</em></td>
                                    }
                                    else if (prop.Name.ToUpper() == "JMBG")
                                    {
                                        var jmbgTekst = (vrednost.ToString() ?? "").Trim().PadLeft(13, '0');
                                        <td style="vnd.ms-excel.numberformat:@@" class="text-start">@jmbgTekst</td>
                                    }
                                    else if (prop.Name == "PeriodUvoza" && vrednost is DateTime datumPerioda)
                                    {
                                        var periodFormatiran = datumPerioda.ToString("MM/yyyy");
                                        <td style="vnd.ms-excel.numberformat:@@">@periodFormatiran</td>
                                    }
                                    else if (vrednost is decimal || vrednost is double || vrednost is float)
                                    {
                                        <td class="text-end">@string.Format("{0:N2}", vrednost)</td>
                                    }
                                    else if (vrednost is DateTime vreme)
                                    {
                                        <td>@vreme.ToString("dd.MM.yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>@vrednost.ToString()</td>
                                    }
                                }
                            </tr>
                            brojac++;
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table td {
        white-space: nowrap;
    }

    .table-responsive {
        max-height: 66vh;
        overflow-y: auto;
        overflow-x: auto;
    }

    @@media print {
        .btn,
        .border-bottom {
            display: none !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ccc !important;
        }

        .table-responsive {
            max-height: none !important;
            overflow-y: visible !important;
            overflow-x: visible !important;
        }
    }
</style>

@section Scripts {
    <script>
        function izveziUExcel() {
            const tabela = document.getElementById("tabela-rfzo");
            if (!tabela) return;

            let html = tabela.outerHTML;
            const style = '<style> td { white-space:nowrap; } </style>';
            const meta = '<meta http-equiv="content-type" content="application/vnd.ms-excel; charset=UTF-8">';
            const template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://w3.org">' + meta + '<head>' + style + '</head><body>' + html + '</body></html>';

            const blob = new Blob([template], {type: "application/vnd.ms-excel"});
            const url = URL.createObjectURL(blob);

            const a = document.createElement("a");
            a.href = url;

            const datum = new Date().toISOString().slice(0, 10);
            a.download = 'Pregled_Uvoza_RFZO_' + datum + '.xls';

            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
}
